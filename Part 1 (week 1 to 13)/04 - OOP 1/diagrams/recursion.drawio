<mxfile host="app.diagrams.net"><diagram id="d1" name="Recursie"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Stack bij factorial(4) op het moment dat de base case bereikt is" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="760" height="30" as="geometry"/></mxCell><mxCell id="c3" value="factorial(1)&lt;br&gt;number = 1  -&gt;  geeft 1 terug" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=14;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="320" height="70" as="geometry"/></mxCell><mxCell id="c4" value="factorial(2)&lt;br&gt;number = 2  wacht op factorial(1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontSize=14;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="320" height="70" as="geometry"/></mxCell><mxCell id="c5" value="factorial(3)&lt;br&gt;number = 3  wacht op factorial(2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontSize=14;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="320" height="70" as="geometry"/></mxCell><mxCell id="c6" value="factorial(4)&lt;br&gt;number = 4  wacht op factorial(3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontSize=14;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="320" height="70" as="geometry"/></mxCell><mxCell id="c7" value="main&lt;br&gt;factorial(4) wordt aangeroepen" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontSize=14;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="320" height="70" as="geometry"/></mxCell><mxCell id="c8" value="base case: hier stopt de recursie" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="90" width="380" height="50" as="geometry"/></mxCell><mxCell id="c9" value="Daarna worden de frames gepopt, van boven naar beneden:&lt;br&gt;factorial(1) geeft 1&lt;br&gt;factorial(2) geeft 2&lt;br&gt;factorial(3) geeft 6&lt;br&gt;factorial(4) geeft 24" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="200" width="380" height="120" as="geometry"/></mxCell><mxCell id="c10" value="Zonder base case komt er nooit een return en blijft de stack groeien." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="350" width="380" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>